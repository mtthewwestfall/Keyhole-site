server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Payment/provider webhooks (NexaPay, Stripe, Shopify) and the Keyhole API are served by
  # the Sorority-house backend; keyhole.cam fronts them so providers get one public URL.
  location /webhooks/ {
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    set $backend ${BACKEND_ORIGIN};
    proxy_pass $backend;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_request_buffering off;
    client_max_body_size 2m;
  }
  # Customer sign-in / sign-up (shared Sorority-house accounts) and the Keyhole API.
  location ~ ^/(keyhole|auth)/ {
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    set $backend ${BACKEND_ORIGIN};
    proxy_pass $backend;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Authorization $http_authorization;
  }
  # Admin console (X-Admin-Secret) and the media library / generated plates.
  location ~ ^/(admin|media)/ {
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    set $backend ${BACKEND_ORIGIN};
    proxy_pass $backend;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Admin-Secret $http_x_admin_secret;
    proxy_read_timeout 300s;
    proxy_request_buffering off;
    client_max_body_size 200m;
  }


  # Tagline Scout (Node sidecar — same path as Netlify Functions)
  location = /.netlify/functions/tagline-search {
    proxy_pass http://127.0.0.1:3456;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_connect_timeout 10s;
  }

  location / { try_files $uri $uri/ /index.html; }
}
